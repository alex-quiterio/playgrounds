root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,h}]
indent_size = 4

[*.go]
indent_style = tab

[*.{rb,lisp}]
indent_size = 2

[*.pl]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.{sud,sqd}]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
