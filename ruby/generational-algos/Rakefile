require 'rake/testtask'
require_relative 'n-queens/n_queens'

Rake::TestTask.new(:test) do |t|
  t.libs << '.'
  t.test_files = FileList['test/**/*_test.rb']
  t.warning = false
end

task default: :test

namespace :generational do
  desc 'N-Queens solved by a generational algorithm, e.g. rake "generational:nqueens[8,1000]"'
  task :nqueens, :size, :maxgen do |_t, args|
    size = (args[:size] || 8).to_i
    maxgen = (args[:maxgen] || 1000).to_i
    solver = NQueens.new(size: size, max_generations: maxgen)
    population = solver.run
    best_match = solver.best(population)
    puts "Fitness: #{best_match[:fitness].round(3)}"
    size.times do |i|
      size.times do |j|
        print '|'
        print((best_match[:gene][i] == j) ? 'Q' : ' ')
        print((j == size - 1) ? "|\n" : '')
      end
    end
  end
end
