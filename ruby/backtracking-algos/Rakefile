require 'rake/testtask'
require_relative 'backtracking_algorithm'
require_relative 'n-queens/nqueens'
require_relative 'sudoku/sudoku'

Rake::TestTask.new(:test) do |t|
  t.libs << '.'
  t.test_files = FileList['test/**/*_test.rb']
  t.warning = false
end

task default: :test

namespace :backtrack do
  def backtrack(problem)
    BacktrackingAlgorithm.new(problem).run
  end

  desc 'Place N queens on an NxN board, e.g. rake "backtrack:nqueens[8]"'
  task :nqueens, :queens do |_t, args|
    problem = NQueens.new((args[:queens] || 8).to_i)
    backtrack(problem)
  end

  desc 'Solve a puzzle from sudoku/puzzles, e.g. rake "backtrack:sudoku[easy01]"'
  task :sudoku, :file_name do |_t, args|
    fail 'Provide a puzzle name, e.g. rake "backtrack:sudoku[easy01]"' if args.file_name.nil?
    problem = Sudoku.new(File.join(__dir__, "sudoku/puzzles/#{args[:file_name]}.sud"))
    backtrack(problem)
  end
end
