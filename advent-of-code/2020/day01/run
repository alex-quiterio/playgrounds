#!/bin/sh
# Usage: ./run INPUT. Compiles solution.cpp (when it changed) and runs it.
dir="$(dirname "$0")"
if [ ! -x "$dir/solution" ] || [ "$dir/solution.cpp" -nt "$dir/solution" ]; then
    c++ -std=c++20 -O2 -Wall -Wextra -o "$dir/solution" "$dir/solution.cpp" || exit 1
fi
exec "$dir/solution" "$@"
